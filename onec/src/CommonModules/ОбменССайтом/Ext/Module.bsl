// Обмен 1С с сайтом «SLA доставки» по HTTP в формате JSON.
//
// Кто за что отвечает:
//   сайт - справочник зон и расчёт SLA (срок и исход каждого заказа, сводка по зонам);
//   1С   - место, где менеджер вносит и правит заказы.
//
// Синхронизация за один запуск:
//   1. GET  /api/zones    - зоны с сайта в справочник «Зоны»;
//   2. POST /api/orders   - новые и изменённые в 1С заказы на сайт (флаг «Нужно отправить»);
//   3. GET  /api/orders   - все заказы сайта со сроком и исходом SLA в справочник «Заказы»;
//   4. GET  /api/by-zone  - сводка SLA по зонам в регистр «Сводка SLA».

// Выполняет все шаги синхронизации и возвращает протокол для показа пользователю.
Функция Синхронизировать() Экспорт

	Протокол = Новый Массив;
	Попытка
		Протокол.Добавить(ЗагрузитьЗоны());
		Протокол.Добавить(ОтправитьЗаказы());
		Протокол.Добавить(ЗагрузитьЗаказы());
		Протокол.Добавить(ЗагрузитьСводку());
	Исключение
		Протокол.Добавить("Ошибка обмена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Протокол.Добавить("Проверьте, что сайт запущен (docker compose up -d api) и адрес сайта: " + АдресСайта());
	КонецПопытки;

	Итог = СтрСоединить(Протокол, Символы.ПС);
	ЗаписьЖурналаРегистрации("Обмен с сайтом", УровеньЖурналаРегистрации.Информация, , , Итог);
	Возврат Итог;

КонецФункции

// --------------------------------------------------------------------- шаги обмена

Функция ЗагрузитьЗоны()

	Зоны = ПолучитьJSON("/api/zones");
	Для Каждого Зона Из Зоны Цикл
		Ссылка = Справочники.Зоны.НайтиПоКоду(Зона["code"]);
		Объект = ?(Ссылка.Пустая(), Справочники.Зоны.СоздатьЭлемент(), Ссылка.ПолучитьОбъект());
		Объект.Код = Зона["code"];
		Объект.Наименование = Зона["name"];
		Объект.ЭкспрессЧасов = Зона["express_hours"];
		Объект.СтандартДней = Зона["standard_days"];
		Объект.Записать();
	КонецЦикла;
	Возврат "Зоны: получено с сайта " + Зоны.Количество();

КонецФункции

Функция ОтправитьЗаказы()

	Запрос = Новый Запрос("ВЫБРАТЬ Заказы.Ссылка КАК Ссылка ИЗ Справочник.Заказы КАК Заказы
	|ГДЕ Заказы.НужноОтправить И НЕ Заказы.ПометкаУдаления");
	Выборка = Запрос.Выполнить().Выбрать();

	Принято = 0;
	Отклонено = 0;
	Пока Выборка.Следующий() Цикл
		Заказ = Выборка.Ссылка.ПолучитьОбъект();

		Тело = Новый Структура;
		Тело.Вставить("order_no", СокрЛП(Заказ.Код));
		Тело.Вставить("channel", КодСайта(Заказ.Канал));
		Тело.Вставить("zone", СокрЛП(Заказ.Зона.Код));
		Тело.Вставить("tariff", КодСайта(Заказ.Тариф));
		Тело.Вставить("status", КодСайта(Заказ.Статус));
		Тело.Вставить("created_at", ДатаВJSON(Заказ.Создан));
		Тело.Вставить("delivered_at", ДатаВJSON(Заказ.Доставлен));
		Тело.Вставить("reschedule_to", ДатаВJSON(Заказ.Перенос));

		Ответ = ОтправитьJSON("/api/orders", Тело);
		Данные = ИзJSON(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
		Если Ответ.КодСостояния = 201 Тогда
			Заказ.Срок = ДатаИзJSON(Данные["deadline"]);
			Заказ.ИсходSLA = ИсходПорусски(Данные["outcome"]);
			Заказ.НужноОтправить = Ложь;
			Заказ.ОшибкаСайта = "";
			Принято = Принято + 1;
		Иначе
			// сайт проверил заказ и вернул причину отказа - показываем её как есть
			Причина = Данные["detail"];
			Если ТипЗнч(Причина) <> Тип("Строка") Тогда
				Причина = "код ответа " + Ответ.КодСостояния + ", неверные поля запроса";
			КонецЕсли;
			Заказ.ОшибкаСайта = Причина;
			Сообщить("Заказ " + Заказ.Код + " не принят сайтом: " + Причина);
			Отклонено = Отклонено + 1;
		КонецЕсли;
		Заказ.ОбменДанными.Загрузка = Истина;  // запись от обмена не должна снова ставить флаг отправки
		Заказ.Записать();
	КонецЦикла;

	Возврат СтрШаблон("Заказы на сайт: принято %1, отклонено %2", Принято, Отклонено);

КонецФункции

Функция ЗагрузитьЗаказы()

	Заказы = ПолучитьJSON("/api/orders");
	Загружено = 0;
	Для Каждого Строка Из Заказы Цикл
		Зона = Справочники.Зоны.НайтиПоКоду(Строка["zone"]);
		Ссылка = Справочники.Заказы.НайтиПоКоду(Строка["order_no"]);
		Если Ссылка.Пустая() Тогда
			Заказ = Справочники.Заказы.СоздатьЭлемент();
			Заказ.Код = Строка["order_no"];
		ИначеЕсли Ссылка.НужноОтправить Тогда
			Продолжить;  // в 1С есть правка, которую сайт не принял: не затираем её
		Иначе
			Заказ = Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Заказ.Канал = ЗначениеИзКода("КаналыЗаказа", Строка["channel"]);
		Заказ.Зона = Зона;
		Заказ.Тариф = ЗначениеИзКода("ТарифыДоставки", Строка["tariff"]);
		Заказ.Статус = ЗначениеИзКода("СтатусыЗаказа", Строка["status"]);
		Заказ.Создан = ДатаИзJSON(Строка["created_at"]);
		Заказ.Доставлен = ДатаИзJSON(Строка["delivered_at"]);
		Заказ.Перенос = ДатаИзJSON(Строка["reschedule_to"]);
		Заказ.Срок = ДатаИзJSON(Строка["deadline"]);
		Заказ.ИсходSLA = ИсходПорусски(Строка["outcome"]);
		Заказ.ОшибкаСайта = "";
		Заказ.ОбменДанными.Загрузка = Истина;
		Заказ.Записать();
		Загружено = Загружено + 1;
	КонецЦикла;
	Возврат "Заказы с сайта: загружено " + Загружено;

КонецФункции

Функция ЗагрузитьСводку()

	Строки = ПолучитьJSON("/api/by-zone");
	Набор = РегистрыСведений.СводкаSLA.СоздатьНаборЗаписей();  // без отбора: запись заменит всю сводку
	Для Каждого Строка Из Строки Цикл
		Запись = Набор.Добавить();
		Запись.Зона = Справочники.Зоны.НайтиПоКоду(Строка["zone"]);
		Запись.Заказов = Строка["total"];
		Запись.Вовремя = Строка["on_time"];
		Запись.Просрочено = Строка["late"] + Строка["open_late"];
		Запись.ПроцентSLA = ЧислоИлиНоль(Строка["sla_pct"]);
		Запись.P50 = ЧислоИлиНоль(Строка["p50_h"]);
		Запись.P90 = ЧислоИлиНоль(Строка["p90_h"]);
	КонецЦикла;
	Набор.Записать();
	Возврат "Сводка SLA: зон " + Строки.Количество();

КонецФункции

// --------------------------------------------------------------------- HTTP и JSON

// Адрес берётся из константы «Адрес сайта SLA»; если она пуста - заполняется адресом по умолчанию.
Функция АдресСайта()
	Адрес = СокрЛП(Константы.АдресСайта.Получить());
	Если Адрес = "" Тогда
		Адрес = "http://localhost:8000";
		Константы.АдресСайта.Установить(Адрес);
	КонецЕсли;
	Возврат Адрес;
КонецФункции

Функция Соединение()
	// "http://localhost:8000" -> сервер "localhost", порт 8000
	Адрес = СтрЗаменить(АдресСайта(), "http://", "");
	Адрес = СтрЗаменить(Адрес, "/", "");
	Части = СтрРазделить(Адрес, ":");
	Порт = ?(Части.Количество() > 1, Число(Части[1]), 80);
	Возврат Новый HTTPСоединение(Части[0], Порт, , , , 15);
КонецФункции

Функция ПолучитьJSON(Путь)
	Ответ = Соединение().Получить(Новый HTTPЗапрос(Путь));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон("сайт ответил на GET %1 кодом %2", Путь, Ответ.КодСостояния);
	КонецЕсли;
	Возврат ИзJSON(Ответ.ПолучитьТелоКакСтроку("UTF-8"));
КонецФункции

Функция ОтправитьJSON(Путь, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Запрос = Новый HTTPЗапрос(Путь);
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8", ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Соединение().ОтправитьДляОбработки(Запрос);
КонецФункции

Функция ИзJSON(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);  // Истина - объекты JSON читаются в Соответствие
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Пустая дата 1С уходит на сайт как null, остальные - как "2026-11-05T09:00:00" (местное время).
Функция ДатаВJSON(Дата)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Дата, "ДФ=yyyy-MM-dd") + "T" + Формат(Дата, "ДФ=HH:mm:ss");
КонецФункции

Функция ДатаИзJSON(Текст)
	Если ТипЗнч(Текст) <> Тип("Строка") ИЛИ Текст = "" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат ПрочитатьДатуJSON(Лев(Текст, 19), ФорматДатыJSON.ISO);
КонецФункции

Функция ЧислоИлиНоль(Значение)
	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);
КонецФункции

// --------------------------------------------------------------------- коды сайта и перечисления 1С

// Коды значений на сайте (sla/domain.py) -> имена значений перечислений 1С.
Функция КодыСайта(ИмяПеречисления)
	Коды = Новый Соответствие;
	Если ИмяПеречисления = "КаналыЗаказа" Тогда
		Коды.Вставить("site", "Сайт");
		Коды.Вставить("marketplace", "Маркетплейс");
		Коды.Вставить("phone", "Телефон");
	ИначеЕсли ИмяПеречисления = "ТарифыДоставки" Тогда
		Коды.Вставить("express", "Экспресс");
		Коды.Вставить("standard", "Стандарт");
	Иначе
		Коды.Вставить("in_transit", "ВПути");
		Коды.Вставить("delivered", "Доставлен");
		Коды.Вставить("cancelled", "Отменен");
	КонецЕсли;
	Возврат Коды;
КонецФункции

Функция ЗначениеИзКода(ИмяПеречисления, Код)
	Возврат Перечисления[ИмяПеречисления][КодыСайта(ИмяПеречисления)[Код]];
КонецФункции

Функция КодСайта(Значение)
	ИмяЗначения = XMLСтрока(Значение);
	Для Каждого Пара Из КодыСайта(Значение.Метаданные().Имя) Цикл
		Если Пара.Значение = ИмяЗначения Тогда
			Возврат Пара.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИсходПорусски(Код)
	Исходы = Новый Соответствие;
	Исходы.Вставить("on_time", "вовремя");
	Исходы.Вставить("late", "просрочен");
	Исходы.Вставить("open_late", "просрочен в пути");
	Исходы.Вставить("in_progress", "в работе");
	Исходы.Вставить("excluded", "не учитывается");
	Исход = Исходы[Код];
	Возврат ?(Исход = Неопределено, "", Исход);
КонецФункции
